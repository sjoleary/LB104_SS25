# Perform ANOVA
anova_model <- aov(length_mm ~ treatment_level, data = length_ex)
# View summary of ANOVA results
summary(anova_model)
# Perform ANOVA
anova_model <- aov(length_mm ~ treatment_level, data = length_A)
# View summary of ANOVA results
summary(anova_model)
# Perform ANOVA
anova_model <- aov(length_mm ~ treatment, data = length_ex)
# View summary of ANOVA results
summary(anova_model)
# Perform ANOVA
anova_model <- aov(length_mm ~ treatment, data = length_A)
# View summary of ANOVA results
summary(anova_model)
# Perform ANOVA
anova_model <- aov(length_mm ~ treatment, data = length_B)
# View summary of ANOVA results
summary(anova_model)
# Perform ANOVA
anova_ex <- aov(length_mm ~ treatment, data = length_ex)
# View summary of ANOVA results
summary(anova_ex)
# Perform ANOVA
anova_A <- aov(length_mm ~ treatment, data = length_A)
# View summary of ANOVA results
summary(anova_A)
# Perform ANOVA
anova_B <- aov(length_mm ~ treatment, data = length_B)
# View summary of ANOVA results
summary(anova_B)
# Post-hoc test to compare treatment levels
TukeyHSD(anova_ex)
library(broom)
# Post-hoc test to compare treatment levels
tukey_df <- tidy(TukeyHSD(anova_model))
# look at first few rows
tukey_df %>%
head() %>%
kable()
# print table with significant pairwise comparisons
tukey_df %>%
filter(adj.p.value <= 0.05)
# print table with significant pairwise comparisons
tukey_df %>%
filter(adj.p.value <= 0.05) %>%
kable()
# Post-hoc test to compare treatment levels
tukey_df <- tidy(TukeyHSD(anova_ex))
# look at first few rows
tukey_df %>%
head() %>%
kable()
# print table with significant pairwise comparisons
tukey_df %>%
filter(adj.p.value <= 0.05) %>%
kable()
# print table with pairwise comparisons that are not significantly different
tukey_df %>%
filter(adj.p.value >= 0.05) %>%
kable()
# Post-hoc test to compare treatment levels
tukey_df <- tidy(TukeyHSD(anova_A))
# look at first few rows
tukey_df %>%
head() %>%
kable()
