#| label: fig-length-histogram
#| fig-cap: "Seedling length distribution after 1 week for radish seeds explosed to various deicers for different concentrations."
# make box plots
ggplot(length_ex,                                   # specify object to plot
aes(x = deicer,                              # column on x-axis
y = length_mm,                           # column on y-axis
color = treatment_level)) +              # column to group by
geom_boxplot() +                                  # plot type
scale_color_manual(values = c("#4E5283",
"#7871AA",
"#D9BBF9",
"#AA9FB1")) +         # modify for custom colors
labs(x = "deicer",                                 # x-axis title
y = "seedling length [mm]") +                  # y-axis title
theme_classic() +                                  # specify theme
theme(legend.position = "bottom")                  # legend position
