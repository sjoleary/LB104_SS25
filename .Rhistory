#| label: tbl-summary-length
#| tbl-cap: "Summary statistics for seedling length. Mean, median, standard deviation (sd), minimum (min) and maximum (max) length in millimeters for seedlings exposed to deicers at various treatment levels."
# calculate summary stats for deicer and treatment_level
summary <- length |>                              # specify object
group_by(deicer, treatment_level) |>            # group by treatment
summarize(mean = mean(seedling_length_mm),
sd = sd(seedling_length_mm),
min = sd(seedling_length_mm),
max = max(seedling_length_mm),
median = median(seedling_length_mm))  # calculate summary stats
# print table
summary |>
kable()
