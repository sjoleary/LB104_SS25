# plot mean and standard deviation
summary <- length_ex %>%
group_by(deicer, treatment_level) %>%
summarise(mean = mean(length_mm),
sd = sd(length_mm))
ggplot(summary) +
geom_pointrange(aes(x = treatment_level,
y = mean,
ymin = mean-sd,
ymax = mean+sd,
color = treatment_level),
size = 1.2) +
facet_grid(. ~ deicer) +
scale_color_manual(values = c("#4E5283",
"#7871AA",
"#D9BBF9",
"#AA9FB1")) +
labs(x = "better x-axis title",
y = "better y-axis title") +
theme_bw() +
theme(legend.position = "bottom")
ggplot(summary) +
geom_pointrange(aes(x = treatment_level,
y = mean,
ymin = mean-sd,
ymax = mean+sd,
color = treatment_level),
size = 1.2) +
facet_grid(. ~ deicer, scales = "free_x") +
scale_color_manual(values = c("#4E5283",
"#7871AA",
"#D9BBF9",
"#AA9FB1")) +
labs(x = "better x-axis title",
y = "better y-axis title") +
theme_bw() +
theme(legend.position = "bottom")
