# calculate summary stats for deicer and treatment_level
summary <- length_ex |>                              # specify object
group_by(deicer, treatment_level) |>            # group by treatment
summarize(mean = mean(length_mm),
sd = sd(length_mm),
min = sd(length_mm),
max = max(length_mm),
median = median(length_mm))  # calculate summary stats
# print table
summary |>
kable(digits = 1)
